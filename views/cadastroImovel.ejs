    <%- include('partials/_header') %>
    <div style="height: 80px;"></div>
  
 
  <section class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6 cadastro-box">
        <h2 class="text-center mb-4">Cadastro de Imóveis</h2>
        <form action="/cadastroUser" method="POST">

            <div class="mb-3 d-flex align-items-center">
            <label class="me-5 label-cadastro">Tipo do Imóvel:</label>
          <div class="form-check form-check-inline me-3">
            <input class="form-check-input" type="radio" name="tipoImovel" id="tipoImovel" value="tipoImovelVenda" required>
            <label class="form-check-label" for="tipoImovelVenda">Venda</label>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-personalizado">CONFIRMAR</button>
            <button type="reset" class="btn btn-dark">CANCELAR</button>
          </div>
          <div class="mt-3 text-center">
            <a href="/login">JÁ TENHO UM CADASTRO</a><br>
          </div>
        </form>
      </div>
    </div>
  </section>

  
  <%- include('partials/_footer') %>

<!-- Script do Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>